{
  "dil": {
    "integrations": {
      "integration": {
        "flows": {
          "flow": {
            "id": "googledriveinbound_test1",
            "name": "googledriveinbound_test1",
            "type": "esb",
            "steps": {
              "step": [
                {
                  "id": "1",
                  "type": "source",
                  "uri": "googledrive://",
                  "options": {
                    "accessToken": "RAW(@{OAuthGoogleDrive})",
                    "tenant": "dovetail",
                    "directoryId": "1QjgwMQB395fa0iuI_zHEew5_RYxiwJFV",
                    "delay": "1000",
                    "initialDelay": "1000",
                    "moveTo": ".dovetail",
                    "gSuiteFiles": "Ignore"
                  }
                },
                {
                  "id": "2",
                  "type": "action",
                  "uri": "file:/data/.assimbly/output",
                  "options": {
                    "fileName": "output.txt"
                  }
                },
                {
                  "id": "3",
                  "type": "sink",
                  "uri": "log:nl.kabisa.flux//",
                  "options": {
                    "skipBodyLineSeparator": "false",
                    "multiline": "true",
                    "showHeaders": "false",
                    "showBody": "true",
                    "showBodyType": "true",
                    "showFiles": "true",
                    "showException": "false",
                    "showStackTrace": "false"
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}