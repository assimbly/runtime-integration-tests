<dil>
    <integrations>
        <integration>
            <flows>
                <flow>
                    <id>gettenantvariable_test1</id>
                    <name>gettenantvariable_test1</name>
                    <type>esb</type>
                    <steps>
                        <step>
                            <id>1</id>
                            <type>source</type>
                            <uri>http://0.0.0.0:9001/1/gettenantvariable</uri>
                        </step>
                        <step>
                            <id>2</id>
                            <type>action</type>
                            <uri>tenantvariables://MyVariable</uri>
                            <options>
                                <operation>SET</operation>
                                <expressionType>constant</expressionType>
                                <value>RAW(eWVzISEh)</value>
                                <encrypt>false</encrypt>
                                <modifier>RAW(Groupless/SetTenantVar)</modifier>
                                <tenant>default</tenant>
                            </options>
                        </step>
                        <step>
                            <id>3</id>
                            <type>action</type>
                            <uri>tenantvariables://MyVariable</uri>
                            <options>
                                <operation>GET</operation>
                                <header>MyVariable</header>
                                <tenant>default</tenant>
                            </options>
                        </step>
                        <step>
                            <id>4</id>
                            <type>sink</type>
                            <uri>setbody:${header.MyVariable}</uri>
                            <options>
                                <language>simple</language>
                            </options>
                        </step>
                    </steps>
                </flow>
            </flows>
        </integration>
    </integrations>
</dil>