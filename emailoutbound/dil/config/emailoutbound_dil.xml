<dil>
    <integrations>
        <integration>
            <flows>
                <flow>
                    <id>email_test1</id>
                    <name>email_test1</name>
                    <type>esb</type>
                    <steps>
                        <step>
                            <id>1</id>
                            <type>source</type>
                            <uri>http://0.0.0.0:9001/1/emailoutbound</uri>
                        </step>
                        <step>
                            <id>2</id>
                            <type>action</type>
                            <uri>setheaders:message:sender</uri>
                        </step>
                        <step>
                            <id>3</id>
                            <type>action</type>
                            <uri>setbody:body - ${header.sender}</uri>
                            <options>
                                <language>simple</language>
                            </options>
                        </step>
                        <step>
                            <id>4</id>
                            <type>action</type>
                            <uri>smtp://mail.smtpbucket.com:8025</uri>
                            <options>
                                <from>${header.sender}</from>
                                <headerFilterStrategy>#ExtendedHeaderFilterStrategy</headerFilterStrategy>
                                <mail.smtp.starttls.enable>true</mail.smtp.starttls.enable>
                                <subject>RAW(testing email component)</subject>
                                <to>johnny.bravo@example.com</to>
                            </options>
                        </step>
                        <step>
                            <id>5</id>
                            <type>action</type>
                            <uri>setheaders:message:CamelHttpUri</uri>
                        </step>
                        <step>
                            <id>6</id>
                            <type>action</type>
                            <uri>setheaders:message:CamelHttpMethod</uri>
                        </step>
                        <step>
                            <id>7</id>
                            <type>action</type>
                            <uri>https://api.smtpbucket.com/emails</uri>
                        </step>
                        <step>
                            <id>8</id>
                            <type>sink</type>
                            <uri>setbody:${bodyAs(String)}</uri>
                            <options>
                                <language>simple</language>
                            </options>
                        </step>
                    </steps>
                </flow>
            </flows>
        </integration>
    </integrations>
    <core>
        <messages>
            <message>
                <id>1</id>
                <name>sender</name>
                <headers>
                    <header>
                        <name>sender</name>
                        <value>dovetail-${uuid}@example.com</value>
                        <language>simple</language>
                        <type>header</type>
                    </header>
                </headers>
            </message>
            <message>
                <id>2</id>
                <name>CamelHttpUri</name>
                <headers>
                    <header>
                        <name>CamelHttpUri</name>
                        <value>https://api.smtpbucket.com/emails?sender=${header.sender}&amp;recipient=johnny.bravo@example.com&amp;limit=1</value>
                        <language>simple</language>
                        <type>header</type>
                    </header>
                </headers>
            </message>
            <message>
                <id>3</id>
                <name>CamelHttpMethod</name>
                <headers>
                    <header>
                        <name>CamelHttpMethod</name>
                        <value>GET</value>
                        <language>constant</language>
                        <type>header</type>
                    </header>
                </headers>
            </message>
        </messages>
    </core>
</dil>