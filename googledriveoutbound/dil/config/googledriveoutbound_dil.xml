<dil>
    <integrations>
        <integration>
            <flows>
                <flow>
                    <id>googledriveoutbound_test1</id>
                    <name>googledriveoutbound_test1</name>
                    <type>esb</type>
                    <steps>
                        <step>
                            <id>1</id>
                            <type>source</type>
                            <uri>http://0.0.0.0:9001/1/googledriveoutbound</uri>
                        </step>
                        <step>
                            <id>2</id>
                            <type>action</type>
                            <uri>setheaders:message:CamelFileName</uri>
                        </step>
                        <step>
                            <id>3</id>
                            <type>action</type>
                            <uri>setbody:<![CDATA[file content text]]></uri>
                        </step>
                        <step>
                            <id>4</id>
                            <type>action</type>
                            <uri>googledrive://</uri>
                            <options>
                                <accessToken>RAW(@{OAuthGoogleDrive})</accessToken>
                                <tenant>dovetail</tenant>
                                <directoryId>1QjgwMQB395fa0iuI_zHEew5_RYxiwJFV</directoryId>
                            </options>
                        </step>
                        <step>
                            <id>5</id>
                            <type>sink</type>
                            <uri>log:nl.kabisa.flux//</uri>
                            <options>
                                <skipBodyLineSeparator>false</skipBodyLineSeparator>
                                <multiline>true</multiline>
                                <showHeaders>false</showHeaders>
                                <showBody>true</showBody>
                                <showBodyType>true</showBodyType>
                                <showFiles>true</showFiles>
                                <showException>false</showException>
                                <showStackTrace>false</showStackTrace>
                            </options>
                        </step>
                    </steps>
                </flow>
            </flows>
        </integration>
    </integrations>
    <core>
        <messages>
            <message>
                <id>1</id>
                <name>CamelFileName</name>
                <headers>
                    <header>
                        <name>CamelFileName</name>
                        <value>simpleFile.txt</value>
                        <language>constant</language>
                        <type>header</type>
                    </header>
                </headers>
            </message>
        </messages>
    </core>
</dil>