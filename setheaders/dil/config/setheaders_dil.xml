<dil>
    <integrations>
        <integration>
            <flows>
                <flow>
                    <id>setheaders_test1</id>
                    <name>setheaders_test1</name>
                    <type>esb</type>
                    <steps>
                        <step>
                            <id>1</id>
                            <type>source</type>
                            <uri>http://0.0.0.0:9001/1/setheaders</uri>
                        </step>
                        <step>
                            <id>2</id>
                            <type>action</type>
                            <uri>setbody:John</uri>
                        </step>
                        <step>
                            <id>3</id>
                            <type>action</type>
                            <uri>setheaders:message:names</uri>
                        </step>
						<step>
                            <id>4</id>
                            <type>sink</type>
                            <uri>setbody:The body is ${body}. The name is ${header.firstname} ${header.lastname}</uri>
                            <options>
                                <language>simple</language>
                            </options>
                        </step>
                    </steps>
                </flow>
            </flows>
        </integration>
    </integrations>
	<core>
	   <messages>
         <message>
            <id>1</id>
            <name>names</name>
            <headers>
                <header>
                    <name>firstname</name>
                    <value>${body}</value>
                    <language>simple</language>
                    <type>header</type>
                </header>
                <header>
                    <name>lastname</name>
                    <value>Doe</value>
                    <language>constant</language>
                    <type>header</type>
                </header>
           </headers>
         </message>
      </messages>
	</core>
</dil>