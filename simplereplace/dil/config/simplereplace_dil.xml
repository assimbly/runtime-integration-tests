<dil>
    <integrations>
        <integration>
            <flows>
                <flow>
                    <id>simplereplace_test1</id>
                    <name>simplereplace_test1</name>
                    <type>esb</type>
                    <steps>
                        <step>
                            <id>1</id>
                            <type>source</type>
                            <uri>http://0.0.0.0:9001/1/simplereplace</uri>
                            <links>
                                <link>
                                    <id>2</id>
                                    <transport>sync</transport>
                                    <bound>out</bound>
                                </link>
                            </links>
                        </step>
                        <step>
                            <id>2</id>
                            <type>action</type>
                            <uri>setheaders:message:names</uri>
                            <links>
                                <link>
                                    <id>2</id>
                                    <transport>sync</transport>
                                    <bound>in</bound>
                                </link>
                                <link>
                                    <id>3</id>
                                    <transport>sync</transport>
                                    <bound>out</bound>
                                </link>
                            </links>
                        </step>
                        <step>
                            <id>3</id>
                            <type>action</type>
                            <uri>setbody:Hello ${header.name}, welcome to ${header.company}.</uri>
                            <options>
                                <language>simple</language>
                            </options>
                            <links>
                                <link>
                                    <id>3</id>
                                    <transport>sync</transport>
                                    <bound>in</bound>
                                </link>
                                <link>
                                    <id>4</id>
                                    <transport>sync</transport>
                                    <bound>out</bound>
                                </link>
                            </links>
                        </step>
                        <step>
                            <id>4</id>
                            <type>action</type>
                            <uri>simplereplace</uri>
                            <links>
                                <link>
                                    <id>4</id>
                                    <transport>sync</transport>
                                    <bound>in</bound>
                                </link>
                                <link>
                                    <id>5</id>
                                    <transport>sync</transport>
                                    <bound>out</bound>
                                </link>
                            </links>
                        </step>
                        <step>
                            <id>5</id>
                            <type>sink</type>
                            <uri>setbody:${bodyAs(String)}</uri>
                            <options>
                                <language>simple</language>
                            </options>
                            <links>
                                <link>
                                    <id>5</id>
                                    <transport>sync</transport>
                                    <bound>in</bound>
                                </link>
                            </links>
                        </step>
                    </steps>
                </flow>
            </flows>
        </integration>
    </integrations>
    <core>
        <messages>
            <message>
                <id>1</id>
                <name>names</name>
                <headers>
                    <header>
                        <name>name</name>
                        <value>Pedro</value>
                        <language>simple</language>
                        <type>header</type>
                    </header>
                    <header>
                        <name>company</name>
                        <value>Dovetail</value>
                        <language>constant</language>
                        <type>header</type>
                    </header>
                </headers>
            </message>
        </messages>
    </core>
</dil>