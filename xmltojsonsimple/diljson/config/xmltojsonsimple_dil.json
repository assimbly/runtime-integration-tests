{
  "dil": {
    "integrations": {
      "integration": {
        "flows": {
          "flow": {
            "id": "xmltojsonsimple_dil",
            "name": "xmltojsonsimple_dil",
            "type": "esb",
            "steps": {
              "step": [
                {
                  "id": "1",
                  "type": "source",
                  "uri": "http://0.0.0.0:9001/1/XmlToJsonSimple",
                  "links": {
                    "link": {
                      "id": "2",
                      "transport": "sync",
                      "bound": "out"
                    }
                  }
                },
                {
                  "id": "2",
                  "type": "action",
                  "uri": "setbody:<persons>\t\t\t\t\t\t\t  <person>\t\t\t\t\t\t\t\t<name>John Doe</name>\t\t\t\t\t\t\t  </person>\t\t\t\t\t\t\t  <person>\t\t\t\t\t\t\t\t<name>Jane Doe</name>\t\t\t\t\t\t\t  </person>\t\t\t\t\t\t\t</persons>                            ",
                  "links": {
                    "link": [
                      {
                        "id": "2",
                        "transport": "sync",
                        "bound": "in"
                      },
                      {
                        "id": "3",
                        "transport": "sync",
                        "bound": "out"
                      }
                    ]
                  }
                },
                {
                  "id": "3",
                  "type": "action",
                  "uri": "xmltojson://",
                  "options": {
                    "keepStrings": false,
                    "removeNamespaces": false,
                    "removeRoot": false,
                    "hasTypes": false,
                    "typeValueMismatch": "ORIGINAL"
                  },
                  "links": {
                    "link": [
                      {
                        "id": "3",
                        "transport": "sync",
                        "bound": "in"
                      },
                      {
                        "id": "4",
                        "transport": "sync",
                        "bound": "out"
                      }
                    ]
                  }
                },
                {
                  "id": "4",
                  "type": "sink",
                  "uri": "setbody:${bodyAs(String)}",
                  "options": {
                    "language": "simple"
                  },
                  "links": {
                    "link": {
                      "id": "4",
                      "transport": "sync",
                      "bound": "in"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}